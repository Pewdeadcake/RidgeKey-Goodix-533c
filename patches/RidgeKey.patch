-static void
-send_retry (Op *op, const GError *e)
-{
-  xpc_object_t ev = xpc_dictionary_create (NULL, NULL, 0);
-
-  xpc_dictionary_set_string (ev, RK_KEY_EVENT, RK_EV_RETRY);
-  xpc_dictionary_set_string (ev, RK_KEY_MESSAGE, e->message);
-  send_event (op, ev);
