+static const char *
+error_code (Op *op, const GError *e)
+{
+  if (op->err_code)
+    return op->err_code;
+  if (op->timed_out)
+    return RK_ERR_TIMEOUT;
+  if (g_error_matches (e, G_IO_ERROR, G_IO_ERROR_CANCELLED))
