-/* Takes ownership of error (may be NULL). */
-static void
-op_finish (Op *op, GError *error)
-{
-  if (error && !op->error)
-    op->error = error;
-  else if (error)
-    g_error_free (error);
-
-  prompt_close (op->prompt);
-  op->prompt = NULL;
-
-  if (op->timeout_id)
-    {
-      g_source_remove (op->timeout_id);
-      op->timeout_id = 0;
-    }
-  if (op->opened)
-    {
-      op->opened = FALSE;
-      fp_device_close (op->dev, NULL, on_closed, op);
-    }
-  else
-    {
-      op_complete (op);
-    }
-}
