-static gboolean
-on_timeout (gpointer data)
-{
-  Op *op = data;
-
-  op->timeout_id = 0;
-  op->timed_out = TRUE;
-  g_cancellable_cancel (op->cancel);
-  return G_SOURCE_REMOVE;
