+{
+  Op *op = data;
+  GError *err = NULL;
+  g_autoptr(FpPrint) print = fp_device_enroll_finish (FP_DEVICE (src), res, &err);
+
+  if (!print)
+    {
+      op_finish (op, err);
+      return;
+    }
+
+  xpc_dictionary_set_string (op->reply, RK_KEY_FINGER, rk_finger_name (op->finger));
