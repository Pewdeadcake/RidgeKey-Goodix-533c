+  g_clear_object (&op->cancel);
+  g_clear_object (&op->old_print);
+  g_clear_pointer (&op->gallery, g_ptr_array_unref);
+  g_clear_error (&op->error);
+  if (op->reply)
+    xpc_release (op->reply);
+  prompt_close (op->prompt);
+  g_free (op->right);
+  g_free (op->client);
+  g_clear_pointer (&op->rules, g_ptr_array_unref);
+  g_clear_pointer (&op->new_rules, g_ptr_array_unref);
+  if (op->tap_timer)
+    g_source_remove (op->tap_timer);
+  g_free (op->username);
+  request_free (op->req);
+  g_free (op);
