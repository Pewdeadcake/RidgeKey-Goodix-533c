+static void
+on_finger_status (GObject *obj, GParamSpec *pspec, gpointer data)
+{
+  Op *op = data;
+  FpFingerStatusFlags st = fp_device_get_finger_status (FP_DEVICE (obj));
+  xpc_object_t ev = xpc_dictionary_create (NULL, NULL, 0);
