+  xpc_dictionary_set_string (ev, RK_KEY_EVENT, RK_EV_FINGER);
+  xpc_dictionary_set_bool (ev, RK_KEY_PRESENT, (st & FP_FINGER_STATUS_PRESENT) != 0);
+  xpc_dictionary_set_bool (ev, RK_KEY_NEEDED, (st & FP_FINGER_STATUS_NEEDED) != 0);
+  send_event (op, ev);
+}
