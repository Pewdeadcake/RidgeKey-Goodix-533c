+#define RK_KEY_PRESENT   "present"
+#define RK_KEY_NEEDED    "needed"
+#define RK_KEY_DEVICE    "device"
+#define RK_KEY_DRIVER    "driver"
+#define RK_KEY_DEVICE_ID "device-id"
+#define RK_KEY_BUSY      "busy"
+#define RK_KEY_VERSION   "version"
+#define RK_KEY_DELETED   "deleted"
+#define RK_KEY_PASSWORD  "password"
+#define RK_KEY_PASSWORD_STORED "password-stored"
+#define RK_KEY_PASSWORD_VALID  "password-valid"
+#define RK_KEY_CONSOLE_USER    "console-user"
+#define RK_KEY_SCREEN_LOCKED   "screen-locked"
+#define RK_KEY_RIGHT           "right"    /* authorize: the authorization right being requested */
+#define RK_KEY_CLIENT          "client"   /* authorize: path of the app asking for it */
+#define RK_KEY_CLIENT_PID      "client-pid" /* authorize: pid of that app = authd's creator-pid (0 = unknown) */
+#define RK_KEY_CALLER_PID      "caller-pid" /* authorize: process that submitted the request (log only) */
+#define RK_KEY_ACTIONS         "actions"  /* actions-get/-set: array of rule dictionaries */
+#define RK_KEY_GESTURE         "gesture"  /* rule: "tap" | "hold" */
+#define RK_KEY_SECONDS         "seconds"  /* rule: hold time */
+#define RK_KEY_TAPS            "taps"     /* rule / action event: 1 single, 2 double, 3 triple tap */
+#define RK_KEY_ACTION          "action"   /* rule / action event: "lock" | "shortcut" */
+#define RK_KEY_SHORTCUT        "shortcut" /* rule / action event: Shortcuts app name */
+#define RK_KEY_HELD            "held"     /* action event: seconds the finger was held */
+#define RK_KEY_LISTENING       "listening" /* status: waiting for finger actions */
+#define RK_KEY_AUTH            "auth"     /* enroll/delete: "password" (+ "password") or "finger" */
+#define RK_KEY_REUSED          "reused"   /* authorize reply: approved from a recent touch */
+
+/* operations */
+#define RK_OP_STATUS    "status"    /* anyone */
+#define RK_OP_LIST      "list"      /* own user, root: any */
+#define RK_OP_ENROLL    "enroll"    /* own user, root: any */
+#define RK_OP_VERIFY    "verify"    /* own user, root: any - matches only that user's prints */
+#define RK_OP_IDENTIFY  "identify"  /* root only - matches every RidgeKey user's prints */
+#define RK_OP_DELETE    "delete"    /* own user, root: any - only prints RidgeKey enrolled */
+#define RK_OP_PURGE     "purge"     /* root only - delete every RidgeKey print, one by one */
+#define RK_OP_CANCEL    "cancel"    /* the client that started the operation, or root */
+#define RK_OP_PASSWORD_SET   "password-set"    /* own user, root: any - validated first */
+#define RK_OP_PASSWORD_CLEAR "password-clear"  /* own user, root: any */
+#define RK_OP_PASSWORD_CHECK "password-check"  /* own user, root: any - reads it back and re-checks it */
+#define RK_OP_AGENT_HELLO "agent-hello" /* the agent at startup: runs the agent checks, logs the result */
+#define RK_OP_UNLOCK    "unlock"    /* the RidgeKey agent only (see peer.c), for the console user while
+                                     * the screen is locked: wait for a matching finger, then reply
+                                     * with "password" so the agent can type it into the lock screen */
+#define RK_OP_ACTIONS_GET "actions-get" /* own user, root: any - finger action rules */
+#define RK_OP_ACTIONS_SET "actions-set" /* own user via a trusted client, root: any - replace them */
+#define RK_OP_AUTHORIZE "authorize" /* root only (the RidgeKey authorization plugin): show an on-screen
+                                     * prompt, match any enrolled admin's finger, then reply with
+                                     * "user" + "password" for macOS to verify (builtin:authenticate).
+                                     * Needs someone at the console with the screen unlocked. */
+
+/* events */
+#define RK_EV_FINGER          "finger"
+#define RK_EV_ENROLL_PROGRESS "enroll-progress"
+#define RK_EV_RETRY           "retry"
+#define RK_EV_CONFIRM         "confirm"     /* enroll/delete: touch an enrolled finger to confirm */
+#define RK_EV_ACTION          "action"      /* to the agent: perform this finger action */
+#define RK_EV_CONFIRMED       "confirmed"   /* confirmation accepted, the operation continues */
+
+/* error codes */
+#define RK_ERR_BAD_REQUEST "bad-request"
+#define RK_ERR_PERMISSION  "permission"
+#define RK_ERR_BUSY        "busy"
+#define RK_ERR_NO_DEVICE   "no-device"
+#define RK_ERR_NOT_FOUND   "not-found"
+#define RK_ERR_NO_PRINTS   "no-prints"
+#define RK_ERR_TIMEOUT     "timeout"
+#define RK_ERR_CANCELLED   "cancelled"
+#define RK_ERR_DATA_FULL   "data-full"
+#define RK_ERR_STORAGE     "storage"
+#define RK_ERR_FAILED      "failed"
+#define RK_ERR_BAD_PASSWORD "bad-password"
+#define RK_ERR_NO_PASSWORD  "no-password"         /* unlock: nothing stored */
+#define RK_ERR_PASSWORD_OUTDATED "password-outdated" /* unlock: stored one no longer works */
+#define RK_ERR_NOT_LOCKED   "not-locked"          /* unlock: not the locked console user */
+#define RK_ERR_NOT_ADMIN    "not-admin"           /* authorize: matched user is not an administrator */
+#define RK_ERR_NO_CONSOLE   "no-console"          /* authorize: nobody at the console, or screen locked */
+#define RK_ERR_AUTH_REQUIRED "auth-required"      /* enroll/delete: confirm with a password or an enrolled finger */
+#define RK_ERR_NO_MATCH     "no-match"            /* enroll/delete: the confirming finger is not enrolled */
+#define RK_ERR_LOCKED_OUT   "locked-out"          /* too many wrong passwords - wait */
+#define RK_ERR_UNTRUSTED    "untrusted-client"    /* not the installed ridgekeyctl / RidgeKey app */
+
+/* Finger names, indexed by libfprint's FpFinger (1..10). Index 0 = unknown. */
+static const char *const rk_finger_names[] = {
+  "unknown",
+  "left-thumb", "left-index", "left-middle", "left-ring", "left-little",
+  "right-thumb", "right-index", "right-middle", "right-ring", "right-little",
+};
+#define RK_FINGER_FIRST 1
+#define RK_FINGER_LAST  10
+
+/* Returns 1..10, or 0 when the name is unknown. */
+static inline int
+rk_finger_from_name (const char *name)
+{
+  int i;
+
+  if (!name)
+    return 0;
+  for (i = RK_FINGER_FIRST; i <= RK_FINGER_LAST; i++)
+    if (strcmp (name, rk_finger_names[i]) == 0)
+      return i;
+  return 0;
+}
+
+static inline const char *
+rk_finger_name (int finger)
+{
+  if (finger < RK_FINGER_FIRST || finger > RK_FINGER_LAST)
+    return rk_finger_names[0];
+  return rk_finger_names[finger];
+}
+
+#endif /* RIDGEKEY_PROTOCOL_H */
diff --git a/src/daemon/bio-keychain.c b/src/daemon/bio-keychain.c
new file mode 100644
index 0000000..8a2f81d
--- /dev/null
+++ b/src/daemon/bio-keychain.c
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: MIT
+ * Host-matched Milan templates live in the encrypted System keychain, not
+ * plaintext .print files. Same root-only daemon boundary as RidgeKey secret.c.
+ * This service is separate from stored login passwords and no password is
+ * needed to enroll or to use the diagnostic identify operation as root.
+ */
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+#include "bio-keychain.h"
+#include <unistd.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define BIO_SERVICE RK_BIO_SERVICE
+#define BIO_MAX (16u*1024u*1024u)
+static void erase(void *p,size_t n){volatile uint8_t *v=p;while(n--)*v++=0;}
+void rk_bio_free(uint8_t *data,size_t size){if(data){erase(data,size);free(data);}}
+static OSStatus open_store(const char *account,SecKeychainRef *kc) {
+    if(geteuid()!=0)return errSecAuthFailed;
+    if(!account || !*account || strlen(account)>127)return errSecParam;
+    for(const char *p=account;*p;++p)if(!((*p>='a'&&*p<='z')||(*p>='0'&&*p<='9')||*p==':'||*p=='-'||*p=='.'))return errSecParam;
+    SecKeychainSetUserInteractionAllowed(false);
+    return SecKeychainOpen("/Library/Keychains/System.keychain",kc);
+}
+static OSStatus find(SecKeychainRef kc,const char *account,SecKeychainItemRef *item,UInt32 *size,void **data) {
+    return SecKeychainFindGenericPassword(kc,(UInt32)strlen(BIO_SERVICE),BIO_SERVICE,
+        (UInt32)strlen(account),account,size,data,item);
+}
+static SecAccessRef access_for_root(void) {
+    /* UID ownership instead of an any-application decrypt ACL. The install
+     * test must prove a separate non-root process cannot read the item. */
+    CFErrorRef error=NULL;
+    SecAccessRef access=SecAccessCreateWithOwnerAndACL(0,0,kSecUseOnlyUID,NULL,&error);
+    if(error)CFRelease(error);return access;
+}
+static OSStatus save_named(const char *account,const uint8_t *data,size_t size) {
+    if(!data || !size || size>BIO_MAX)return errSecParam;
+    SecKeychainRef kc=NULL;SecKeychainItemRef item=NULL;
+    OSStatus st=open_store(account,&kc);if(st!=errSecSuccess)return st;
+    st=find(kc,account,&item,NULL,NULL);
+    if(st==errSecSuccess)st=SecKeychainItemModifyAttributesAndData(item,NULL,(UInt32)size,data);
+    else if(st==errSecItemNotFound) {
+        SecAccessRef access=access_for_root();
+        if(!access)st=errSecAuthFailed;
+        else {
+            const char label[]="RidgeKey 533c - encrypted biometric template";
+            SecKeychainAttribute attrs[3]={
+                {kSecServiceItemAttr,(UInt32)strlen(BIO_SERVICE),(void *)BIO_SERVICE},
+                {kSecAccountItemAttr,(UInt32)strlen(account),(void *)account},
+                {kSecLabelItemAttr,sizeof label-1,(void *)label}};
+            SecKeychainAttributeList list={3,attrs};
+            st=SecKeychainItemCreateFromContent(kSecGenericPasswordItemClass,&list,(UInt32)size,data,kc,access,&item);
+            CFRelease(access);
+        }
+    }
+    if(item)CFRelease(item);CFRelease(kc);return st;
+}
+static OSStatus load_named(const char *account,uint8_t **data,size_t *size) {
+    if(!data || !size)return errSecParam;*data=NULL;*size=0;
+    SecKeychainRef kc=NULL;SecKeychainItemRef item=NULL;UInt32 count=0;void *value=NULL;
+    OSStatus st=open_store(account,&kc);if(st!=errSecSuccess)return st;
+    st=find(kc,account,&item,&count,&value);
+    if(st==errSecSuccess) {
+        if(!count || count>BIO_MAX)st=errSecDecode;
+        else {
+            *data=malloc(count);
+            if(!*data)st=errSecAllocate;else {memcpy(*data,value,count);*size=count;}
+        }
+    }
+    if(value){erase(value,count);SecKeychainItemFreeContent(NULL,value);}
+    if(item)CFRelease(item);CFRelease(kc);return st;
+}
+OSStatus rk_bio_remove(uid_t uid,int finger) {
+    if(finger<1 || finger>10)return errSecParam;
+    char account[64];snprintf(account,sizeof account,"%u:%d",(unsigned)uid,finger);
+    SecKeychainRef kc=NULL;SecKeychainItemRef item=NULL;
+    OSStatus st=open_store(account,&kc);if(st!=errSecSuccess)return st;
+    st=find(kc,account,&item,NULL,NULL);if(st==errSecSuccess)st=SecKeychainItemDelete(item);
+    if(item)CFRelease(item);CFRelease(kc);return st==errSecItemNotFound?errSecSuccess:st;
+}
+OSStatus rk_bio_save(uid_t uid,int finger,const uint8_t *data,size_t size) {
+    if(finger<1 || finger>10)return errSecParam;
+    char account[64];snprintf(account,sizeof account,"%u:%d",(unsigned)uid,finger);
+    return save_named(account,data,size);
+}
+OSStatus rk_bio_load(uid_t uid,int finger,uint8_t **data,size_t *size) {
+    if(finger<1 || finger>10)return errSecParam;
+    char account[64];snprintf(account,sizeof account,"%u:%d",(unsigned)uid,finger);
+    return load_named(account,data,size);
+}
+static int state_identity(const char *identity) {
+    const char prefix[]="goodix53x5-preprocess-";
+    size_t n=sizeof prefix-1;
+    if(!identity || strlen(identity)!=n+64+4 || strncmp(identity,prefix,n) || strcmp(identity+n+64,".bin"))return 0;
+    for(size_t i=n;i<n+64;++i)if(!((identity[i]>='0'&&identity[i]<='9')||(identity[i]>='a'&&identity[i]<='f')))return 0;
+    return 1;
+}
+OSStatus rk_bio_state_save(const char *identity,const uint8_t *data,size_t size) {
+    return state_identity(identity)?save_named(identity,data,size):errSecParam;
+}
+OSStatus rk_bio_state_load(const char *identity,uint8_t **data,size_t *size) {
+    return state_identity(identity)?load_named(identity,data,size):errSecParam;
+}
diff --git a/src/daemon/bio-keychain.h b/src/daemon/bio-keychain.h
new file mode 100644
index 0000000..22fe5a7
--- /dev/null
