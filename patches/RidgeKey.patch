-  [ $Q_ROOT = 1 ] && { "$PB" -c "Add :rule:$i string is-root" "$w"; i=$((i + 1)); }
-  [ $Q_ENT = 1 ]  && { "$PB" -c "Add :rule:$i string entitled" "$w"; i=$((i + 1)); }
-  "$PB" -c "Add :rule:$i string $FP_RULE" -c "Add :rule:$((i + 1)) string $ORIG$name" "$w"
-  "$PB" -c "Delete :comment" "$w" >/dev/null 2>&1 || true
-  "$PB" -c "Add :comment string RidgeKey: fingerprint first, then the original rule ($ORIG$name)." "$w"
-
-  if write_right "$name" "$w" && is_wrapped "$TMP/check.plist"; then
-    echo "  ok $name"
-  else
-    write_right "$name" "$o" || true
-    security authorizationdb remove "$ORIG$name" >/dev/null 2>&1 || true
-    rm -f "$STATE/$name.plist"
-    echo "  !! $name: could not be changed - left as it was"
-    return 1
-  fi
-}
-
-unwrap() {   # RIGHT
-  local name=$1 b="$STATE/$1.plist" live="$TMP/live.plist"
-  [ -f "$b" ] || { echo "  -  $name: not enabled by RidgeKey"; return 0; }
-  if read_right "$name" "$live" && is_wrapped "$live"; then
-    if ! write_right "$name" "$b" || is_wrapped "$TMP/check.plist"; then
-      echo "  !! $name: could not restore the original - kept the backup in $b"; return 1
-    fi
-    echo "  ok $name: original restored"
-  else
-    echo "  ok $name: changed since (macOS update?) - left as it is"
-  fi
-  security authorizationdb remove "$ORIG$name" >/dev/null 2>&1 || true
-  rm -f "$b"
-}
-
-enabled_rights() {
-  [ -d "$STATE" ] || return 0
-  local f
-  for f in "$STATE"/*.plist; do [ -f "$f" ] && basename "$f" .plist; done
-}
-
-cmd_enable() {
-  need_root enable
-  [ -f "$PLUGIN/Contents/MacOS/RidgeKey" ] || die "$PLUGIN is missing - run install.sh first"
-  do_selftest || die "not enabling anything: macOS could not run the RidgeKey plugin"
-  ensure_fp_rule
