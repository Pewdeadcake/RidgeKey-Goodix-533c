diff --git a/libfprint/drivers/goodix53x5/family/htsec/open.c b/libfprint/drivers/goodix53x5/family/htsec/open.c
new file mode 100644
index 0000000..1f88487
--- /dev/null
+++ b/libfprint/drivers/goodix53x5/family/htsec/open.c
@@ -0,0 +1,230 @@
+/*
+ * Goodix 53x5 driver for libfprint â€” HTSEC bring-up
+ * Copyright (C) 2024 goodix-fp-linux-dev contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define FP_COMPONENT "goodix53x5"
+
+#include "drivers_api.h"
+#include "driver-private.h"
+#include "device/commands.h"
+#include "device/session.h"
+#include "family/htsec/htsec.h"
+
+/* The production slot holding the SHA-256 of the sensor's PSK. */
+#define GOODIX_HTSEC_PSK_HASH_TYPE 0xB003
+
+/* PSK white box for writing the default all-zero PSK. */
+#define GOODIX_PSK_WHITE_BOX_LEN 96
+
+/* PSK white box for writing the default all-zero PSK. */
+static const guint8 goodix_psk_white_box[GOODIX_PSK_WHITE_BOX_LEN] = {
+  0xec, 0x35, 0xae, 0x3a, 0xbb, 0x45, 0xed, 0x3f,
+  0x12, 0xc4, 0x75, 0x1f, 0x1e, 0x5c, 0x2c, 0xc0,
+  0x5b, 0x3c, 0x54, 0x52, 0xe9, 0x10, 0x4d, 0x9f,
+  0x2a, 0x31, 0x18, 0x64, 0x4f, 0x37, 0xa0, 0x4b,
+  0x6f, 0xd6, 0x6b, 0x1d, 0x97, 0xcf, 0x80, 0xf1,
+  0x34, 0x5f, 0x76, 0xc8, 0x4f, 0x03, 0xff, 0x30,
+  0xbb, 0x51, 0xbf, 0x30, 0x8f, 0x2a, 0x98, 0x75,
+  0xc4, 0x1e, 0x65, 0x92, 0xcd, 0x2a, 0x2f, 0x9e,
+  0x60, 0x80, 0x9b, 0x17, 0xb5, 0x31, 0x60, 0x37,
+  0xb6, 0x9b, 0xb2, 0xfa, 0x5d, 0x4c, 0x8a, 0xc3,
+  0x1e, 0xdb, 0x33, 0x94, 0x04, 0x6e, 0xc0, 0x6b,
+  0xbd, 0xac, 0xc5, 0x7d, 0xa6, 0xa7, 0x56, 0xc5,
+};
+
+typedef enum {
+  GOODIX_HTSEC_OPEN_PROBE,
+  GOODIX_HTSEC_OPEN_RESET,
+  GOODIX_HTSEC_OPEN_READ_OTP,
+  GOODIX_HTSEC_OPEN_PARSE_OTP,
+  GOODIX_HTSEC_OPEN_READ_PSK_HASH,
+  GOODIX_HTSEC_OPEN_WRITE_PSK,
+  GOODIX_HTSEC_OPEN_VERIFY_PSK_WRITE,
+  GOODIX_HTSEC_OPEN_CHANNEL,
+  GOODIX_HTSEC_OPEN_NUM_STATES,
+} GoodixHtsecOpenState;
+
+#ifdef GOODIX53X5_DEBUG
+static const gchar *
+goodix_htsec_open_state_name (GoodixHtsecOpenState state)
+{
+  switch (state)
+    {
+    case GOODIX_HTSEC_OPEN_PROBE:
+      return "ping";
+    case GOODIX_HTSEC_OPEN_RESET:
+      return "reset";
+    case GOODIX_HTSEC_OPEN_READ_OTP:
+      return "read_otp";
+    case GOODIX_HTSEC_OPEN_PARSE_OTP:
+      return "parse_otp";
+    case GOODIX_HTSEC_OPEN_READ_PSK_HASH:
+      return "read_psk_hash";
+    case GOODIX_HTSEC_OPEN_WRITE_PSK:
+      return "write_psk";
+    case GOODIX_HTSEC_OPEN_VERIFY_PSK_WRITE:
+      return "verify_psk_write";
+    case GOODIX_HTSEC_OPEN_CHANNEL:
+      return "gtls_client_hello";
+    case GOODIX_HTSEC_OPEN_NUM_STATES:
+    default:
+      return "unknown";
+    }
+}
+#endif
+
+/* Brings a 53x5 up to an established GTLS session: wake it and read its
+ * firmware version, identify the chip, read the OTP, make sure the sensor
+ * holds this driver's PSK, writing the default one where it holds another
+ * and no key was imported, then run the handshake. */
+static void
+goodix_htsec_open_handler (FpiSsm *ssm, FpDevice *dev)
+{
+  FpiDeviceGoodix53x5 *self = FPI_DEVICE_GOODIX53X5 (dev);
+  GoodixHtsecOpenState state = fpi_ssm_get_cur_state (ssm);
+
+  goodix_debug_timing_open_state (self, dev, goodix_htsec_open_state_name (state),
+                                  g_get_monotonic_time ());
+
+  switch (state)
+    {
+    case GOODIX_HTSEC_OPEN_PROBE:
+      goodix_open_probe (ssm, dev, 5, goodix_htsec_check_firmware);
+      break;
+
+    case GOODIX_HTSEC_OPEN_RESET:
+      goodix_open_identify_chip (ssm, dev, FALSE);
+      break;
+
+    case GOODIX_HTSEC_OPEN_READ_OTP:
+      goodix_cmd_read_otp (ssm, dev);
+      break;
+
+    case GOODIX_HTSEC_OPEN_PARSE_OTP:
+      {
+        g_autoptr(GError) error = NULL;
+
+        if (!goodix_open_parse_otp (dev, &error) || !goodix_load_psk (self, &error))
+          {
+            fpi_ssm_mark_failed (ssm, g_steal_pointer (&error));
+            return;
+          }
+        fpi_ssm_next_state (ssm);
+      }
+      break;
+
+    case GOODIX_HTSEC_OPEN_READ_PSK_HASH:
+      goodix_cmd_production_read (ssm, dev, GOODIX_HTSEC_PSK_HASH_TYPE);
+      break;
+
+    case GOODIX_HTSEC_OPEN_WRITE_PSK:
+      {
+        gboolean matches;
+        GError *error = NULL;
+
+        if (!goodix_psk_hash_reply_matches (dev, GOODIX_HTSEC_PSK_HASH_TYPE, &matches, &error))
+          {
+            fpi_ssm_mark_failed (ssm, error);
+            return;
+          }
+        if (matches)
+          {
+            fp_dbg ("PSK hash matches, no need to write");
+            self->psk_write_verify_pending = FALSE;
+            fpi_ssm_jump_to_state (ssm, GOODIX_HTSEC_OPEN_CHANNEL);
+            return;
+          }
+
+        if (self->psk_imported)
+          {
+            fpi_ssm_mark_failed (
+              ssm,
+              fpi_device_error_new_msg (FP_DEVICE_ERROR_DATA_INVALID,
+                                        "Sensor PSK does not match imported Windows PSK; refusing to overwrite it"));
+            return;
+          }
+
+        fp_info ("Writing default PSK white box");
+        self->psk_write_verify_pending = TRUE;
+        goodix_cmd_production_write (ssm, dev, 0xB002, goodix_psk_white_box,
+                                     GOODIX_PSK_WHITE_BOX_LEN);
+      }
+      break;
+
+    case GOODIX_HTSEC_OPEN_VERIFY_PSK_WRITE:
+      {
+        const guint8 *pl;
+        gsize pl_len;
+
+        if (!goodix_cmd_parse_production_write_reply (dev, &pl, &pl_len) ||
+            pl_len < 1)
+          {
+            fpi_ssm_mark_failed (ssm,
+                                 fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                                           "Failed to parse PSK write reply"));
+            return;
+          }
+
+        if (pl[0] != 0)
+          {
+            fpi_ssm_mark_failed (ssm,
+                                 fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                                           "PSK write failed: %u",
+                                                           pl[0]));
+            return;
+          }
+
+        /* Re-read the PSK hash to verify the write before GTLS */
+        goodix_cmd_production_read (ssm, dev, GOODIX_HTSEC_PSK_HASH_TYPE);
+      }
+      break;
+
+    case GOODIX_HTSEC_OPEN_CHANNEL:
+      {
+        if (self->psk_write_verify_pending)
+          {
+            /* The previous state re-read the hash of the PSK just written. */
+            gboolean matches;
+            GError *error = NULL;
+
+            if (!goodix_psk_hash_reply_matches (dev, GOODIX_HTSEC_PSK_HASH_TYPE, &matches, &error))
+              {
+                g_clear_error (&error);
+                fpi_ssm_mark_failed (ssm,
+                                     fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                                               "Failed to re-read PSK hash"));
+                return;
+              }
+
+            if (!matches)
+              {
+                fpi_ssm_mark_failed (ssm,
+                                     fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO,
+                                                               "PSK hash mismatch after write"));
+                return;
+              }
+
+            self->psk_write_verify_pending = FALSE;
+          }
+
+        goodix_open_channel (ssm, dev);
+      }
+      break;
+
+    case GOODIX_HTSEC_OPEN_NUM_STATES:
+      g_assert_not_reached ();
+      break;
+    }
+}
+
+FpiSsm *
+goodix_htsec_open_new (FpDevice *dev)
+{
+  return fpi_ssm_new (dev, goodix_htsec_open_handler, GOODIX_HTSEC_OPEN_NUM_STATES);
+}
diff --git a/libfprint/drivers/goodix53x5/family.h b/libfprint/drivers/goodix53x5/family.h
new file mode 100644
index 0000000..061bdcf
--- /dev/null
+++ b/libfprint/drivers/goodix53x5/family.h
@@ -0,0 +1,187 @@
+/*
+ * Goodix 53x5 driver for libfprint â€” sensor families
+ * Copyright (C) 2026 goodix-fp-linux-dev contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#pragma once
+
+#include <glib.h>
+
+typedef struct _FpDevice FpDevice;
+typedef struct _FpiSsm FpiSsm;
+typedef struct _FpiDeviceGoodix53x5 FpiDeviceGoodix53x5;
+typedef struct _GoodixTransport GoodixTransport;
+typedef struct _GoodixCmd GoodixCmd;
+
+/* How the bytes of one sensor family reach the driver. */
+typedef struct
+{
+  guint8   usb_interface;
+  guint8   ep_in;
+  guint8   ep_out;
+  /* Returns the bytes to write for the protocol message @msg, or NULL when
+   * the framing cannot carry it. */
+  guint8 *(*frame) (const guint8 *msg, gsize msg_len, gsize *out_len);
+  /* Returns the bytes to write for a raw secure-channel record, or NULL when
+   * the framing cannot carry it; NULL where the channel rides in protocol
+   * messages and nothing is written raw. */
+  guint8 *(*frame_record) (GBytes *record, gsize *out_len);
+  /* Hands the bytes of one completed IN transfer to the receiver through
+   * goodix_rx_cell(), goodix_rx_image() and goodix_mcu_publish(). */
+  void    (*receive) (FpiDeviceGoodix53x5 *self, GoodixTransport *operation,
+                      const guint8 *data, gsize len);
+  /* Drops any partial frame kept between transfers; NULL where none is. */
+  void    (*discard) (FpiDeviceGoodix53x5 *self);
+} GoodixLink;
+
+/* What a message from the sensor means beyond being a reply. */
+typedef enum
+{
+  GOODIX_SENSOR_EVENT_NONE,
+  /* The sensor lost its configuration and keys; the scan restores the
+   * configuration and the next channel handshake re-checks the PSK. */
+  GOODIX_SENSOR_EVENT_CONFIG_LOST,
+  /* The sensor asks for a new secure-channel session, after which finger
+   * detection is armed again. */
+  GOODIX_SENSOR_EVENT_RECONNECT,
+} GoodixSensorEvent;
+
+typedef enum
+{
+  GOODIX_FDT_EVENT_DOWN = 0,
+  GOODIX_FDT_EVENT_UP,
+  GOODIX_FDT_EVENT_REVERSE,
+  GOODIX_FDT_EVENT_NONE,
+  GOODIX_FDT_EVENT_CONFIG,
+  GOODIX_FDT_EVENT_ESD,
+  GOODIX_FDT_EVENT_WAKE,
+  GOODIX_FDT_EVENT_DEACTIVATE,
+} GoodixFdtEventType;
+
+#define GOODIX_FDT_IRQ_DOWN 0x0002
+#define GOODIX_FDT_IRQ_REVERSE 0x0080
+#define GOODIX_FDT_IRQ_REVERSE_ALT 0x0082
+#define GOODIX_FDT_IRQ_UP 0x0200
+
+/* The family's rules of the shared MCU protocol. */
+typedef struct
+{
+  /* Bytes of the wake NOP's zero payload. */
+  gsize    wake_payload_len;
+  /* The EC-control payload that isolates the power button while the sensor
+   * scans; every family ends isolation with three zero bytes. */
+  guint8   ec_on_payload[3];
+  /* Sets the ACK and data budgets, in ms, and permits one timeout retry. */
+  gboolean (*command_budget) (guint8 command, gboolean expect_data,
+                               guint *ack_ms, guint *response_ms);
+  /* Checks whether a failed write may use the command's retry. */
+  gboolean (*retry_write) (const GError *error);
+  /* Checks whether an arm ACK needs a local config download and repeat. */
+  gboolean (*repair_arm) (guint8 status);
+  /* Selects up rather than down after a wake notice. */
+  gboolean (*wake_arm_up) (gboolean waiting_up);
+  /* Publishes a valid ESD notice's IRQ in the family's response storage. */
+  gboolean (*notice_irq) (FpiDeviceGoodix53x5 *self, const guint8 *payload, gsize len);
+  /* Validates and classifies a down/up notification. */
+  GoodixFdtEventType (*fdt_event) (FpiDeviceGoodix53x5 *self,
+                                  const guint8 *payload, gsize len, GError **error);
+  /* TRUE where an ACK that does not come in time is not an error for a
+   * command that expects data: the wait moves on to the data, as the
+   * vendor's _IoHubExec does. FALSE retries the command. */
+  gboolean ack_timeout_waits_for_data;
+  /* Returns the event a complete, valid message carries, or NONE. */
+  GoodixSensorEvent (*event) (guint8 category, guint8 command,
+                              const guint8 *payload, gsize len);
+  /* Checks whether a reply with @category/@command answers @awaited when
+   * both share a response slot. */
+  gboolean (*reply_answers) (guint8 category, guint8 command,
+                             const GoodixCmd *awaited);
+  /* Checks whether a configuration download reply reports success. */
+  gboolean (*download_succeeded) (const guint8 *payload, gsize len);
+  /* Checks whether the driver may send @cmd at all. */
+  gboolean (*may_send) (const GoodixCmd *cmd);
+} GoodixProtocol;
+
+typedef enum
+{
+  /* Decrypted by the established session. */
+  GOODIX_FRAME_DECRYPTED,
+  /* Rejected before the session was established; says nothing about the session. */
+  GOODIX_FRAME_REJECTED,
+  /* Rejected on an established session; counts towards restarting it. */
+  GOODIX_FRAME_REJECTED_IN_SESSION,
+  /* Decrypted, but not an image; the session that decrypted it is sound. */
+  GOODIX_FRAME_INVALID,
+} GoodixFrameStatus;
+
+/* Handshake attempts before a secure-channel start gives up, by what
+ * started it. */
+typedef struct
+{
+  /* Open and resume. */
+  guint open;
+  /* A restart after an image read the channel rejected. */
+  guint after_failed_read;
+  /* A new session the sensor asked for. */
+  guint reconnect;
+} GoodixChannelAttempts;
+
+/* The family's secure channel. */
+typedef enum
+{
+  GOODIX_CHANNEL_START,
+  GOODIX_CHANNEL_FAILED_READ,
+  GOODIX_CHANNEL_RECONNECT,
+} GoodixChannelReason;
+
+typedef struct
+{
+  /* The channel's name in logs. */
+  const char           *name;
+  GoodixChannelAttempts attempts;
+  guint                 retry_delay_ms;
+  /* Returns a new SSM for one handshake attempt. */
+  FpiSsm             *(*attempt_new) (FpDevice *dev, GoodixChannelReason reason);
+  /* Decrypts an encrypted image payload into raw12 bytes in @out. */
+  GoodixFrameStatus   (*decrypt_frame) (FpiDeviceGoodix53x5 *self,
+                                        const guint8 *payload, gsize len,
+                                        guint8 **out, gsize *out_len);
+  /* Counts one undecodable frame; returns TRUE when the channel must be
+   * restarted for it. */
+  gboolean            (*image_error) (FpiDeviceGoodix53x5 *self);
+  /* Checks whether a failed capture may arm while channel recovery is pending. */
+  gboolean            (*rearm_after_capture) (FpiDeviceGoodix53x5 *self);
+  /* TRUE where starting a new session drops the finger-detect arm, so a
+   * restart still pending runs before an arm. */
+  gboolean              restart_disarms;
+  /* Notes an ACK reporting lost configuration, before the shared loss state
+   * changes; NULL where the channel keeps no state for it. */
+  void                (*config_lost) (FpiDeviceGoodix53x5 *self);
+  /* Forgets the session and its keys when the device closes; NULL where
+   * the channel keeps nothing beyond the shared PSK. */
+  void                (*discard) (FpiDeviceGoodix53x5 *self);
+} GoodixChannel;
+
+/* One sensor family: the same GF5288 sensor and pipeline behind its own MCU
+ * firmware. Shared code uses these pieces and never asks which family it
+ * runs. */
+typedef struct
+{
+  GoodixLink     link;
+  GoodixProtocol protocol;
+  GoodixChannel  channel;
+  /* Returns a new SSM running the family's bring-up, from the first probe
+   * to the established secure channel. The open SSM runs it between claiming
+   * the interface and the first configuration download. */
+  FpiSsm      *(*open_new) (FpDevice *dev);
+} GoodixFamily;
+
+/* 5335/5385/5395: direct framing on interface 1, GTLS, HTSEC MCU. */
+extern const GoodixFamily goodix_family_htsec;
+/* 533c: wrapped framing on interface 0, TLS 1.2-PSK, GM168SEC MCU. */
+extern const GoodixFamily goodix_family_gm168sec;
diff --git a/libfprint/drivers/goodix53x5/goodix53x5.c b/libfprint/drivers/goodix53x5/goodix53x5.c
new file mode 100644
index 0000000..4547070
--- /dev/null
+++ b/libfprint/drivers/goodix53x5/goodix53x5.c
@@ -0,0 +1,184 @@
+/*
+ * Goodix 53x5 driver for libfprint
+ * Copyright (C) 2024 goodix-fp-linux-dev contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#define FP_COMPONENT "goodix53x5"
+
+#include "drivers_api.h"
+#include "driver-private.h"
+#include "device/session.h"
+#include "device/enroll.h"
+#include "device/auth.h"
+#include "device/persistence.h"
+#include "device/transport.h"
+#include "device/scan.h"
+
+#include <string.h>
+
+G_DEFINE_TYPE (FpiDeviceGoodix53x5, fpi_device_goodix53x5,
+               FP_TYPE_DEVICE)
+
+/* ========================================================================
+ * FpDevice virtual methods
+ * ======================================================================== */
+
+static void
+goodix_open (FpDevice *dev)
+{
+  FpiDeviceGoodix53x5 *self = FPI_DEVICE_GOODIX53X5 (dev);
+
+  self->open_recovery_attempted = FALSE;
+  self->open_usb_reset_required = FALSE;
+  g_clear_object (&self->session_cancel);
+  self->session_cancel = g_cancellable_new ();
+  self->session_suspended = FALSE;
+  self->suspend_pending = FALSE;
+  goodix_start_open_ssm (dev);
+}
+
+static void
+goodix_close (FpDevice *dev)
+{
+  goodix_session_close (dev);
+}
+
+static void
+goodix_enroll (FpDevice *dev)
+{
+  goodix_session_start_action (dev);
+}
+
+static void
+goodix_verify (FpDevice *dev)
+{
+  goodix_session_start_action (dev);
+}
+
+static void
+goodix_identify (FpDevice *dev)
+{
+  goodix_session_start_action (dev);
+}
+
+static void
+goodix_suspend (FpDevice *dev)
+{
+  goodix_session_suspend (dev);
+}
+
+static void
+goodix_resume (FpDevice *dev)
+{
+  goodix_session_resume (dev);
+}
+
+static void
+goodix_cancel (FpDevice *dev)
+{
+  FpiDeviceGoodix53x5 *self = FPI_DEVICE_GOODIX53X5 (dev);
+
+  if (goodix_session_cancel_pending_action (dev))
+    return;
+
+  if (self->cancel)
+    {
+      self->action_epoch++;
+      g_cancellable_cancel (self->cancel);
+    }
+}
+
+static void
+goodix_removed (FpDevice *dev, GParamSpec *pspec, gpointer data)
+{
+  FpiDeviceGoodix53x5 *self = FPI_DEVICE_GOODIX53X5 (dev);
+  gboolean removed = FALSE;
+
+  g_object_get (dev, "removed", &removed, NULL);
+  if (!removed || (!self->session_open && !self->task_ssm))
+    return;
+  self->needs_reinit = TRUE;
+  if (self->session_cancel)
+    g_cancellable_cancel (self->session_cancel);
+  goodix_scan_stop_coordinator (
+    dev, fpi_device_error_new (FP_DEVICE_ERROR_REMOVED));
+}
+
+/* ========================================================================
+ * GObject boilerplate
+ * ======================================================================== */
+
+static void
+fpi_device_goodix53x5_init (FpiDeviceGoodix53x5 *self)
+{
+#ifdef GOODIX53X5_DEBUG
+  g_autofree gchar *capture_session_id = g_uuid_string_random ();
+
+  g_strlcpy (self->debug_capture_session_id, capture_session_id,
+             sizeof (self->debug_capture_session_id));
+#endif
+  memset (self->psk, 0, sizeof (self->psk));
+  self->profile9_fdt.drift_anchor_empty = TRUE;
+  self->session_cancel = g_cancellable_new ();
+  g_signal_connect (self, "notify::removed", G_CALLBACK (goodix_removed), NULL);
+}
+
+static const FpIdEntry goodix53x5_id_table[] = {
+  { .vid = 0x27c6, .pid = 0x533c, .driver_data = GOODIX_FAMILY_GM168SEC },
+  { .vid = 0, .pid = 0, .driver_data = 0 },
+};
+
+static void
+goodix_finalize (GObject *object)
+{
+  FpiDeviceGoodix53x5 *self = FPI_DEVICE_GOODIX53X5 (object);
+
+  goodix_milan_generation_invalidate (&self->milan_retained_generation);
+  if (goodix_family (self)->link.discard)
+    goodix_family (self)->link.discard (self);
+  if (goodix_family (self)->channel.discard)
+    goodix_family (self)->channel.discard (self);
+  g_clear_pointer (&self->hardware_reference, g_free);
+  g_clear_object (&self->session_cancel);
+  G_OBJECT_CLASS (fpi_device_goodix53x5_parent_class)->finalize (object);
+}
+
+static void
+fpi_device_goodix53x5_class_init (FpiDeviceGoodix53x5Class *klass)
+{
+  FpDeviceClass *dev_class = FP_DEVICE_CLASS (klass);
+
+  G_OBJECT_CLASS (klass)->finalize = goodix_finalize;
+  dev_class->id = "goodix53x5";
+  dev_class->full_name = "Goodix HTK32 Fingerprint Sensor";
+  dev_class->type = FP_DEVICE_TYPE_USB;
+  dev_class->scan_type = FP_SCAN_TYPE_PRESS;
+  dev_class->id_table = goodix53x5_id_table;
+  dev_class->nr_enroll_stages = GOODIX_ENROLL_SAMPLES;
+  /* Native Milan has no equivalent time-based thermal cutoff. */
+  dev_class->temp_hot_seconds = -1;
+  dev_class->features = FP_DEVICE_FEATURE_VERIFY | FP_DEVICE_FEATURE_IDENTIFY;
+
+  dev_class->open = goodix_open;
+  dev_class->close = goodix_close;
+  dev_class->enroll = goodix_enroll;
+  dev_class->verify = goodix_verify;
+  dev_class->identify = goodix_identify;
+  dev_class->cancel = goodix_cancel;
+  dev_class->suspend = goodix_suspend;
+  dev_class->resume  = goodix_resume;
+}
