+static int32_t
+milan_match_scan_round_pixel_s32 (int32_t value)
+{
+  int32_t rounded_q8 = goodix_milan_transform_sar32 (
+    (uint32_t) value + UINT32_C (0x80), 8);
+
+  return goodix_milan_transform_sar32 (
+    (uint32_t) rounded_q8 + UINT32_C (0x80), 8);
