+
+int goodix_milan_antifake_build_with_boundary (const uint16_t                    *calibration,
+                                               const uint16_t                    *raw_frame,
+                                               const uint8_t                     *classification_plane,
+                                               const uint8_t                     *feature_mask,
+                                               size_t                             feature_mask_size,
+                                               size_t                             rows,
+                                               size_t                             columns,
