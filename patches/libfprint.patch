+
+static gboolean
+goodix_milan_print_fail (GError                **error,
+                         GoodixMilanPrintError   code,
+                         const gchar            *message)
+{
+  g_set_error_literal (error, GOODIX_MILAN_PRINT_ERROR, code, message);
