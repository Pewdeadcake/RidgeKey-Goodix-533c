@@ -0,0 +1,39 @@
+/*
+ * Goodix 53x5 driver for libfprint â€” the GM168SEC family (27c6:533c)
+ * Copyright (C) 2026 goodix-fp-linux-dev contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#pragma once
+
+#include "driver-private.h"
+
+/* The prefix before the TLS records of a 0xb2 pack (image data). */
+#define GOODIX_PACK_TLS_DATA_HDR   9
+
+/* 533c ships with the all-zero PSK; this slot holds its SHA-256. */
+#define GOODIX_WRAPPED_PSK_HASH_TYPE 0xbb020001
+#define GOODIX_PSK_HASH_LEN          32
+
+/* Fails without a firmware version, or with one that is not for the
+ * GM168 or GM168SEC platform, as the vendor's SelfCheck does. */
+GError *goodix_gm168sec_check_firmware (const char *firmware);
+/* Returns a new SSM running the 533c bring-up. */
+FpiSsm *goodix_gm168sec_open_new (FpDevice *dev);
+
+/* Returns a new SSM for one TLS handshake attempt. */
+FpiSsm *goodix_tls_attempt_new (FpDevice *dev, GoodixChannelReason reason);
+/* Decrypts the TLS records of an image pack into raw12 bytes in @out. */
+GoodixFrameStatus goodix_decrypt_frame_tls (FpiDeviceGoodix53x5 *self,
+                                            const guint8 *payload, gsize len,
+                                            guint8 **out, gsize *out_len);
+/* Counts an undecodable frame; always TRUE. */
+gboolean goodix_tls_image_error (FpiDeviceGoodix53x5 *self);
+/* Frees the TLS session. */
+void     goodix_tls_discard (FpiDeviceGoodix53x5 *self);
+/* Drops the receive stream and any partial pack in it. */
+void     goodix_drop_pack_stream (FpiDeviceGoodix53x5 *self);
diff --git a/libfprint/drivers/goodix53x5/family/gm168sec/open.c b/libfprint/drivers/goodix53x5/family/gm168sec/open.c
new file mode 100644
index 0000000..94fd17c
--- /dev/null
+++ b/libfprint/drivers/goodix53x5/family/gm168sec/open.c
@@ -0,0 +1,224 @@
+/*
+ * Goodix 53x5 driver for libfprint â€” GM168SEC bring-up
+ * Copyright (C) 2026 goodix-fp-linux-dev contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define FP_COMPONENT "goodix53x5"
+
+#include "drivers_api.h"
+#include "driver-private.h"
+#include "device/commands.h"
+#include "device/session.h"
+#include "family/gm168sec/gm168sec.h"
+
+typedef enum {
+  GOODIX_GM168SEC_OPEN_PROBE,
+  GOODIX_GM168SEC_OPEN_FIRMWARE,
+  GOODIX_GM168SEC_OPEN_FIRMWARE_RETRY,
+  GOODIX_GM168SEC_OPEN_PSK_READ,
+  GOODIX_GM168SEC_OPEN_PSK_CHECK,
+  GOODIX_GM168SEC_OPEN_RESET,
+  GOODIX_GM168SEC_OPEN_CHIP,
+  GOODIX_GM168SEC_OPEN_READ_OTP,
+  GOODIX_GM168SEC_OPEN_PARSE_OTP,
+  GOODIX_GM168SEC_OPEN_CHANNEL,
+  GOODIX_GM168SEC_OPEN_NUM_STATES,
+} GoodixGm168secOpenState;
+
+#ifdef GOODIX53X5_DEBUG
+static const gchar *
+goodix_gm168sec_open_state_name (GoodixGm168secOpenState state)
+{
+  switch (state)
+    {
+    case GOODIX_GM168SEC_OPEN_PROBE:
+      return "ping";
+    case GOODIX_GM168SEC_OPEN_FIRMWARE:
+    case GOODIX_GM168SEC_OPEN_FIRMWARE_RETRY:
+      return "firmware";
+    case GOODIX_GM168SEC_OPEN_PSK_READ:
+      return "early_psk_read";
+    case GOODIX_GM168SEC_OPEN_PSK_CHECK:
+      return "early_psk_check";
+    case GOODIX_GM168SEC_OPEN_RESET:
+      return "reset";
+    case GOODIX_GM168SEC_OPEN_CHIP:
+      return "chip";
+    case GOODIX_GM168SEC_OPEN_READ_OTP:
+      return "read_otp";
+    case GOODIX_GM168SEC_OPEN_PARSE_OTP:
+      return "parse_otp";
+    case GOODIX_GM168SEC_OPEN_CHANNEL:
+      return "gtls_client_hello";
+    case GOODIX_GM168SEC_OPEN_NUM_STATES:
+    default:
+      return "unknown";
+    }
+}
+#endif
+
+static void
+goodix_gm168sec_probe_result (FpiSsm *ssm, FpDevice *dev, guint8 status,
+                             gboolean native_zero, GError *error)
+{
+  FpiDeviceGoodix53x5 *self = FPI_DEVICE_GOODIX53X5 (dev);
+  GoodixGm168secOpenState state = fpi_ssm_get_cur_state (ssm);
+
+  if (error && !native_zero)
+    {
+      fpi_ssm_mark_failed (ssm, error);
+      return;
+    }
+  if (state == GOODIX_GM168SEC_OPEN_PROBE)
+    {
+      g_clear_error (&error);
+      fpi_ssm_next_state (ssm);
+      return;
+    }
+  if (error)
+    {
+      g_clear_error (&error);
+      if (state == GOODIX_GM168SEC_OPEN_FIRMWARE)
+        fpi_ssm_next_state (ssm);
+      else
+        fpi_ssm_mark_failed (ssm, goodix_gm168sec_check_firmware (NULL));
+      return;
+    }
+  g_free (self->fw_version);
+  self->fw_version = g_strndup ((const gchar *) self->shared_response,
+                                sizeof (self->shared_response));
+  error = goodix_gm168sec_check_firmware (self->fw_version);
+  if (error)
+    fpi_ssm_mark_failed (ssm, error);
+  else
+    fpi_ssm_jump_to_state (ssm, GOODIX_GM168SEC_OPEN_PSK_READ);
+}
+
+static void
+goodix_gm168sec_chip_result (FpiSsm *ssm, FpDevice *dev, guint8 status,
+                            gboolean native_zero, GError *error)
+{
+  FpiDeviceGoodix53x5 *self = FPI_DEVICE_GOODIX53X5 (dev);
+  const guint8 *payload;
+  gsize len;
+
+  if (fpi_ssm_get_cur_state (ssm) == GOODIX_GM168SEC_OPEN_RESET && (!error || native_zero))
+    {
+      g_clear_error (&error);
+      fpi_ssm_next_state_delayed (ssm, 10);
+      return;
+    }
+  if (error || !goodix_cmd_parse_chip_id_reply (dev, &payload, &len, &error))
+    {
+      fpi_ssm_mark_failed (ssm, error);
+      return;
+    }
+  if (len != 4)
+    {
+      fpi_ssm_mark_failed (ssm, fpi_device_error_new_msg (
+                            FP_DEVICE_ERROR_PROTO, "Unexpected chip ID reply length: %zu", len));
+      return;
+    }
+  self->chip_id = goodix_crypto_decode_u32 (payload);
+  if (!goodix_milan_runtime_subtype_for_chip (self->chip_id, &self->milan_sensor_subtype))
+    fpi_ssm_mark_failed (ssm, fpi_device_error_new_msg (
+                          FP_DEVICE_ERROR_NOT_SUPPORTED, "Unsupported chip 0x%08x", self->chip_id));
+  else
+    fpi_ssm_next_state (ssm);
+}
+
+/* Brings a 533c up to an established TLS session in the vendor's order:
+ * SelfCheck's firmware reads, the PSK check the vendor makes before it
+ * resets the sensor, the chip ID read after a reset asking for the IRQ
+ * reply, the OTP, then the handshake. The driver never writes a PSK here,
+ * so one that does not match fails open. */
+static void
+goodix_gm168sec_open_handler (FpiSsm *ssm, FpDevice *dev)
+{
+  FpiDeviceGoodix53x5 *self = FPI_DEVICE_GOODIX53X5 (dev);
+  GoodixGm168secOpenState state = fpi_ssm_get_cur_state (ssm);
+
+  goodix_debug_timing_open_state (self, dev, goodix_gm168sec_open_state_name (state),
+                                  g_get_monotonic_time ());
+
+  switch (state)
+    {
+    case GOODIX_GM168SEC_OPEN_PROBE:
+    case GOODIX_GM168SEC_OPEN_FIRMWARE:
+    case GOODIX_GM168SEC_OPEN_FIRMWARE_RETRY:
+      goodix_cmd_probe (ssm, dev, state != GOODIX_GM168SEC_OPEN_PROBE,
+                         goodix_gm168sec_probe_result);
+      break;
+
+    case GOODIX_GM168SEC_OPEN_PSK_READ:
+      {
+        g_autoptr(GError) error = NULL;
+
+        if (!goodix_load_psk (self, &error))
+          {
+            fpi_ssm_mark_failed (ssm, g_steal_pointer (&error));
+            return;
+          }
+        goodix_cmd_preset_read (ssm, dev, GOODIX_WRAPPED_PSK_HASH_TYPE, GOODIX_PSK_HASH_LEN);
+      }
+      break;
+
+    case GOODIX_GM168SEC_OPEN_PSK_CHECK:
+      {
+        GError *error = NULL;
+
+        if (!goodix_require_current_psk (dev, GOODIX_WRAPPED_PSK_HASH_TYPE, &error))
+          fpi_ssm_mark_failed (ssm, error);
+        else
+          fpi_ssm_next_state (ssm);
+      }
+      break;
+
+    case GOODIX_GM168SEC_OPEN_RESET:
+      self->profile9_fdt.drift_anchor_empty = TRUE;
+      goodix_health_reset (&self->health);
+      self->capture_callback_pending = FALSE;
+      goodix_cmd_reset_sensor (ssm, dev, TRUE, goodix_gm168sec_chip_result);
+      break;
+
+    case GOODIX_GM168SEC_OPEN_CHIP:
+      goodix_cmd_read_chip_id (ssm, dev, goodix_gm168sec_chip_result);
+      break;
+
+    case GOODIX_GM168SEC_OPEN_READ_OTP:
+      goodix_cmd_read_otp (ssm, dev);
+      break;
+
+    case GOODIX_GM168SEC_OPEN_PARSE_OTP:
+      {
+        g_autoptr(GError) error = NULL;
+
+        if (!goodix_open_parse_otp (dev, &error))
+          {
+            fpi_ssm_mark_failed (ssm, g_steal_pointer (&error));
+            return;
+          }
+        fpi_ssm_next_state (ssm);
+      }
+      break;
+
+    case GOODIX_GM168SEC_OPEN_CHANNEL:
+      goodix_open_channel (ssm, dev);
+      break;
+
+    case GOODIX_GM168SEC_OPEN_NUM_STATES:
+      g_assert_not_reached ();
+      break;
+    }
+}
+
+FpiSsm *
+goodix_gm168sec_open_new (FpDevice *dev)
+{
+  return fpi_ssm_new (dev, goodix_gm168sec_open_handler, GOODIX_GM168SEC_OPEN_NUM_STATES);
+}
diff --git a/libfprint/drivers/goodix53x5/family/gm168sec/tls.c b/libfprint/drivers/goodix53x5/family/gm168sec/tls.c
new file mode 100644
index 0000000..5639a6f
--- /dev/null
+++ b/libfprint/drivers/goodix53x5/family/gm168sec/tls.c
@@ -0,0 +1,236 @@
+/*
+ * Goodix 53x5 driver for libfprint â€” TLS-PSK for wrapped sensors
+ * Copyright (C) 2026 goodix-fp-linux-dev contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define FP_COMPONENT "goodix53x5"
+
+#include "drivers_api.h"
+#include "family/gm168sec/tls.h"
+
+#include <openssl/err.h>
+#include <openssl/ssl.h>
+
+/* The suite the sensor negotiates with a stock `openssl s_server -psk`. */
+#define GOODIX_TLS_CIPHER "PSK-AES128-CBC-SHA256"
+#define GOODIX_TLS_MAX_PSK 64
+/* McuStartTls gives up after this many handshake calls. Each of its calls
+ * reads all the input there is and ends in one empty 50 ms wait, so only an
+ * empty wait uses one up. */
+#define GOODIX_TLS_MAX_HANDSHAKE_CALLS 10
+
+struct _GoodixTls
+{
+  SSL_CTX *ctx;
+  SSL     *ssl;
+  BIO     *in;   /* records from the sensor; owned by ssl */
+  BIO     *out;  /* records for the sensor; owned by ssl */
+  guint8   psk[GOODIX_TLS_MAX_PSK];
+  gsize    psk_len;
+  guint    handshake_calls;
+};
+
+static unsigned int
+goodix_tls_psk_cb (SSL *ssl, const char *identity, unsigned char *psk,
+                   unsigned int max_psk_len)
+{
+  GoodixTls *tls = SSL_get_app_data (ssl);
+
+  if (g_strcmp0 (identity, "Client_identity") != 0 || tls->psk_len > max_psk_len)
+    return 0;
+  memcpy (psk, tls->psk, tls->psk_len);
+  return tls->psk_len;
+}
+
+static void
+goodix_tls_set_error (GError **error, const char *what)
+{
+  char buf[256] = "unknown error";
+  unsigned long code = ERR_get_error ();
+
+  if (code)
+    ERR_error_string_n (code, buf, sizeof (buf));
+  ERR_clear_error ();
+  g_set_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+               "TLS %s failed: %s", what, buf);
+}
+
+GoodixTls *
+goodix_tls_new (const guint8 *psk, gsize psk_len, GError **error)
+{
+  GoodixTls *tls;
+
+  g_return_val_if_fail (psk_len <= GOODIX_TLS_MAX_PSK, NULL);
+  tls = g_new0 (GoodixTls, 1);
+  memcpy (tls->psk, psk, psk_len);
+  tls->psk_len = psk_len;
+
+  tls->ctx = SSL_CTX_new (TLS_server_method ());
+  if (!tls->ctx ||
+      !SSL_CTX_set_min_proto_version (tls->ctx, TLS1_2_VERSION) ||
+      !SSL_CTX_set_max_proto_version (tls->ctx, TLS1_2_VERSION) ||
+      !SSL_CTX_set_cipher_list (tls->ctx, GOODIX_TLS_CIPHER))
+    {
+      goodix_tls_set_error (error, "setup");
+      goodix_tls_free (tls);
+      return NULL;
+    }
+  SSL_CTX_set_options (tls->ctx, SSL_OP_NO_TICKET | SSL_OP_NO_RENEGOTIATION);
+  SSL_CTX_set_psk_server_callback (tls->ctx, goodix_tls_psk_cb);
+
+  tls->ssl = SSL_new (tls->ctx);
+  tls->in = BIO_new (BIO_s_mem ());
+  tls->out = BIO_new (BIO_s_mem ());
+  if (!tls->ssl || !tls->in || !tls->out)
+    {
+      BIO_free (tls->in);
+      BIO_free (tls->out);
+      tls->in = tls->out = NULL;
+      goodix_tls_set_error (error, "setup");
+      goodix_tls_free (tls);
+      return NULL;
+    }
+  /* An empty input BIO means "wait for more", not end of stream. */
+  BIO_set_mem_eof_return (tls->in, -1);
+  SSL_set_bio (tls->ssl, tls->in, tls->out);
+  SSL_set_app_data (tls->ssl, tls);
+  SSL_set_accept_state (tls->ssl);
+  return tls;
+}
+
+void
+goodix_tls_free (GoodixTls *tls)
+{
+  if (!tls)
+    return;
+  SSL_free (tls->ssl);
+  SSL_CTX_free (tls->ctx);
+  OPENSSL_cleanse (tls->psk, sizeof (tls->psk));
+  g_free (tls);
+}
+
+static GBytes *
+goodix_tls_take_output (GoodixTls *tls)
+{
+  char *data;
+  long len = BIO_get_mem_data (tls->out, &data);
+  GBytes *out;
+
+  if (len <= 0)
+    return NULL;
+  out = g_bytes_new (data, len);
+  (void) BIO_reset (tls->out);
+  return out;
+}
+
+gboolean
+goodix_tls_handshake (GoodixTls    *tls,
+                      const guint8 *in,
+                      gsize         in_len,
+                      GBytes      **out,
+                      GError      **error)
+{
+  int ret;
+
+  *out = NULL;
+  if (!in_len && ++tls->handshake_calls > GOODIX_TLS_MAX_HANDSHAKE_CALLS)
+    {
+      g_set_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                   "TLS handshake did not finish in %d empty waits",
+                   GOODIX_TLS_MAX_HANDSHAKE_CALLS);
+      return FALSE;
+    }
+  if (in_len && BIO_write (tls->in, in, in_len) != (int) in_len)
+    {
+      goodix_tls_set_error (error, "input");
+      return FALSE;
+    }
+
+  ret = SSL_do_handshake (tls->ssl);
+  if (ret == 1 || SSL_get_error (tls->ssl, ret) == SSL_ERROR_WANT_READ)
+    {
+      *out = goodix_tls_take_output (tls);
+      return TRUE;
+    }
+
+  goodix_tls_set_error (error, "handshake");
+  return FALSE;
+}
+
+gboolean
+goodix_tls_established (GoodixTls *tls)
+{
+  return SSL_is_init_finished (tls->ssl);
+}
+
+gboolean
+goodix_tls_handshake_pending (GoodixTls *tls)
+{
+  return tls->handshake_calls < GOODIX_TLS_MAX_HANDSHAKE_CALLS;
+}
+
+/* Checks whether @records is a run of whole TLS records, each its header
+ * and the length that header announces. OpenSSL would keep a cut
+ * record, even a bare header, for the next call and fail that one instead. */
+static gboolean
+goodix_tls_records_whole (const guint8 *records, gsize len)
+{
+  gsize offset = 0;
+
+  while (offset + GOODIX_TLS_RECORD_HEADER <= len)
+    {
+      const guint8 *header = records + offset;
+
+      offset += GOODIX_TLS_RECORD_HEADER + (header[3] << 8 | header[4]);
+    }
+  return offset == len;
+}
+
+guint8 *
+goodix_tls_decrypt (GoodixTls    *tls,
+                    const guint8 *records,
+                    gsize         records_len,
+                    gsize        *out_len)
+{
+  GByteArray *plain = g_byte_array_new ();
+  guint8 buf[16 * 1024];
+  gboolean ok;
+  int ret = 0;
+
+  if (!goodix_tls_records_whole (records, records_len))
+    {
+      fp_warn ("TLS record is incomplete");
+      g_byte_array_free (plain, TRUE);
+      return NULL;
+    }
+  ok = BIO_write (tls->in, records, records_len) == (int) records_len;
+  while (ok && (ret = SSL_read (tls->ssl, buf, sizeof (buf))) > 0)
+    g_byte_array_append (plain, buf, ret);
+  OPENSSL_cleanse (buf, sizeof (buf));
+
+  if (ok && SSL_get_error (tls->ssl, ret) != SSL_ERROR_WANT_READ)
+    {
+      fp_warn ("TLS record did not authenticate");
+      ok = FALSE;
+    }
+  else if (ok && !plain->len)
+    {
+      fp_warn ("TLS records carried no data");
+      ok = FALSE;
+    }
+  ERR_clear_error ();
+  if (!ok)
+    {
+      OPENSSL_cleanse (plain->data, plain->len);
+      g_byte_array_free (plain, TRUE);
+      return NULL;
+    }
+
+  *out_len = plain->len;
+  return g_byte_array_free (plain, FALSE);
+}
diff --git a/libfprint/drivers/goodix53x5/family/gm168sec/tls.h b/libfprint/drivers/goodix53x5/family/gm168sec/tls.h
new file mode 100644
index 0000000..66f5eb9
--- /dev/null
+++ b/libfprint/drivers/goodix53x5/family/gm168sec/tls.h
@@ -0,0 +1,45 @@
+/*
+ * Goodix 53x5 driver for libfprint â€” TLS-PSK for wrapped sensors
+ * Copyright (C) 2026 goodix-fp-linux-dev contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#pragma once
+
+#include <glib.h>
+
+/* A TLS record's header: content type, version, and its big-endian length. */
+#define GOODIX_TLS_RECORD_HEADER 5
+
+/* The host (server) end of a wrapped sensor's TLS 1.2-PSK session: the one
+ * place its records are produced and authenticated; transport only moves them. */
+typedef struct _GoodixTls GoodixTls;
+
+GoodixTls *goodix_tls_new (const guint8 *psk,
+                           gsize         psk_len,
+                           GError      **error);
+void       goodix_tls_free (GoodixTls *tls);
+
+/* Advances the handshake with the sensor's records in @in, which may be
+ * empty; @out receives the records to send back, or NULL. Fails, and
+ * leaves the session unusable, when the sensor's records are rejected or
+ * the handshake takes more than ten calls. */
+gboolean   goodix_tls_handshake (GoodixTls    *tls,
+                                 const guint8 *in,
+                                 gsize         in_len,
+                                 GBytes      **out,
+                                 GError      **error);
+gboolean   goodix_tls_established (GoodixTls *tls);
+gboolean   goodix_tls_handshake_pending (GoodixTls *tls);
+
+/* Returns the plaintext of application-data records, or NULL when one does
+ * not authenticate or the last is incomplete; either leaves the session
+ * unusable. */
+guint8    *goodix_tls_decrypt (GoodixTls    *tls,
+                               const guint8 *records,
+                               gsize         records_len,
+                               gsize        *out_len);
diff --git a/libfprint/drivers/goodix53x5/family/htsec/gtls.c b/libfprint/drivers/goodix53x5/family/htsec/gtls.c
new file mode 100644
index 0000000..c0c65e6
--- /dev/null
+++ b/libfprint/drivers/goodix53x5/family/htsec/gtls.c
@@ -0,0 +1,162 @@
+/*
+ * Goodix 53x5 driver for libfprint â€” the HTSEC secure channel (GTLS)
+ * Copyright (C) 2024 goodix-fp-linux-dev contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define FP_COMPONENT "goodix53x5"
+
+#include "drivers_api.h"
+#include "driver-private.h"
+#include "device/transport.h"
+#include "device/commands.h"
+#include "device/session.h"
+#include "family/htsec/htsec.h"
+
+#include <string.h>
+#include <openssl/crypto.h>
+#include <openssl/rand.h>
+
+typedef enum {
+  GOODIX_GTLS_HELLO,
+  GOODIX_GTLS_IDENTITY,
+  GOODIX_GTLS_VERIFY,
+  GOODIX_GTLS_COMPLETION,
+  GOODIX_GTLS_READY,
+  GOODIX_GTLS_NUM_STATES,
+} GoodixGtlsState;
+
+static void
+goodix_gtls_ssm_handler (FpiSsm *ssm, FpDevice *dev)
+{
+  FpiDeviceGoodix53x5 *self = FPI_DEVICE_GOODIX53X5 (dev);
+  const guint8 *mcu_data;
+  gsize mcu_len;
+  g_autoptr(GError) error = NULL;
+
+  if (g_cancellable_set_error_if_cancelled (goodix_session_io_cancellable (dev), &error))
+    {
+      fpi_ssm_mark_failed (ssm, g_steal_pointer (&error));
+      return;
+    }
+
+  switch ((GoodixGtlsState) fpi_ssm_get_cur_state (ssm))
+    {
+    case GOODIX_GTLS_HELLO:
+      goodix_transport_reset_mcu (dev);
+      goodix_crypto_gtls_init (&self->gtls, self->psk);
+      if (RAND_bytes (self->gtls.client_random, 32) != 1)
+        {
+          fpi_ssm_mark_failed (ssm, fpi_device_error_new_msg (
+                                 FP_DEVICE_ERROR_PROTO, "GTLS client random generation failed"));
+          return;
+        }
+      goodix_cmd_mcu_send (ssm, dev, 0xFF01, self->gtls.client_random, 32);
+      break;
+
+    case GOODIX_GTLS_IDENTITY:
+      self->gtls.state = 2;
+      goodix_recv_mcu (ssm, dev, GOODIX_CHANNEL_REPLY_TIMEOUT_MS, 72);
+      break;
+
+    case GOODIX_GTLS_VERIFY:
+      if (!goodix_cmd_parse_mcu_reply (dev, 0xFF02, &mcu_data, &mcu_len) || mcu_len != 64)
+        {
+          fpi_ssm_mark_failed (ssm, fpi_device_error_new_msg (
+                                FP_DEVICE_ERROR_PROTO, "Invalid GTLS server identity"));
+          return;
+        }
+      memcpy (self->gtls.server_random, mcu_data, 32);
+      memcpy (self->gtls.server_identity, mcu_data + 32, 32);
+      goodix_crypto_gtls_derive_keys (&self->gtls);
+      if (!goodix_crypto_gtls_verify_identity (&self->gtls))
+        {
+          fpi_ssm_mark_failed (ssm, fpi_device_error_new_msg (
+                                FP_DEVICE_ERROR_PROTO, "GTLS identity verification failed"));
+          return;
+        }
+      {
+        guint8 verify_data[36];
+
+        memcpy (verify_data, self->gtls.client_identity, 32);
+        memset (verify_data + 32, 0xEE, 4);
+        goodix_cmd_mcu_send (ssm, dev, 0xFF03, verify_data, 36);
+      }
+      break;
+
+    case GOODIX_GTLS_COMPLETION:
+      self->gtls.state = 4;
+      goodix_recv_mcu (ssm, dev, GOODIX_CHANNEL_REPLY_TIMEOUT_MS, 12);
+      break;
+
+    case GOODIX_GTLS_READY:
+      if (!goodix_cmd_parse_mcu_reply (dev, 0xFF04, &mcu_data, &mcu_len))
+        {
+          fpi_ssm_mark_failed (ssm, fpi_device_error_new_msg (
+                                FP_DEVICE_ERROR_PROTO, "Failed to parse GTLS done"));
+          return;
+        }
+      /* The native completion is exactly twelve bytes including the MCU
+       * header. Its four trailing bytes are not a result code. */
+      if (mcu_len != 4)
+        {
+          fpi_ssm_mark_failed (ssm, fpi_device_error_new_msg (
+                                FP_DEVICE_ERROR_PROTO, "Wrong GTLS done payload size: %zu", mcu_len));
+          return;
+        }
+      self->gtls.hmac_client_counter = self->gtls.hmac_client_counter_init;
+      self->gtls.hmac_server_counter = self->gtls.hmac_server_counter_init;
+      self->gtls.state = 5;
+      fpi_ssm_next_state (ssm);
+      break;
+
+    case GOODIX_GTLS_NUM_STATES:
+      g_assert_not_reached ();
+    }
+}
+
+FpiSsm *
+goodix_gtls_attempt_new (FpDevice *dev, GoodixChannelReason reason)
+{
+  (void) reason;
+  return fpi_ssm_new (dev, goodix_gtls_ssm_handler, GOODIX_GTLS_NUM_STATES);
+}
+
+/* A GTLS frame counts against an established session only once it consumed
+ * the HMAC counter. */
+GoodixFrameStatus
+goodix_decrypt_frame_gtls (FpiDeviceGoodix53x5 *self, const guint8 *payload,
+                           gsize len, guint8 **out, gsize *out_len)
+{
+  guint32 counter = self->gtls.hmac_server_counter;
+
+  *out = goodix_crypto_gtls_decrypt_sensor_data (&self->gtls, payload, len, out_len);
+  if (*out)
+    return GOODIX_FRAME_DECRYPTED;
+  return self->gtls.hmac_server_counter != counter && self->gtls.state == 5 ?
+         GOODIX_FRAME_REJECTED_IN_SESSION : GOODIX_FRAME_REJECTED;
+}
+
+/* Restarts the session at every second undecodable frame. Successful frames
+ * do not clear the history. */
+gboolean
+goodix_gtls_image_error (FpiDeviceGoodix53x5 *self)
+{
+  if (!self->image_error_history)
+    {
+      self->image_error_history = TRUE;
+      return FALSE;
+    }
+  self->image_error_history = FALSE;
+  return TRUE;
+}
+
+void
+goodix_gtls_discard (FpiDeviceGoodix53x5 *self)
+{
+  OPENSSL_cleanse (self->gtls.psk, sizeof (self->gtls.psk));
+}
diff --git a/libfprint/drivers/goodix53x5/family/htsec/htsec.c b/libfprint/drivers/goodix53x5/family/htsec/htsec.c
new file mode 100644
index 0000000..3dbac74
--- /dev/null
+++ b/libfprint/drivers/goodix53x5/family/htsec/htsec.c
@@ -0,0 +1,233 @@
+/*
+ * Goodix 53x5 driver for libfprint â€” the HTSEC family (5335/5385/5395)
+ * Copyright (C) 2024 goodix-fp-linux-dev contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define FP_COMPONENT "goodix53x5"
+
+#include "drivers_api.h"
+#include "driver-private.h"
+#include "device/transport.h"
+#include "family/htsec/htsec.h"
+
+#include <string.h>
+
+/* USB endpoints â€” interface 1, CDC Data class */
+#define GOODIX_EP_OUT (0x03 | FPI_USB_ENDPOINT_OUT)
+#define GOODIX_EP_IN  (0x01 | FPI_USB_ENDPOINT_IN)
+
+/* The 53x5 native budgets: the command table, with fixed fallbacks for
+ * commands it does not list. */
+static gboolean
+goodix_htsec_command_budget (guint8 command, gboolean expect_data,
+                             guint *ack_ms, guint *response_ms)
+{
+  const GoodixCommandPolicy *policy = goodix_cmd_policy (command);
+
+  *ack_ms = policy ? policy->ack_ms : GOODIX_ACK_TIMEOUT;
+  *response_ms = policy && policy->response_ms ? policy->response_ms : GOODIX_DATA_TIMEOUT;
+  return policy && policy->retry &&
+         (expect_data == (policy->response_slot != GOODIX_RESPONSE_NONE));
+}
+
+static gboolean
+goodix_htsec_retry_write (const GError *error)
+{
+  return error && error->domain == G_USB_DEVICE_ERROR &&
+         (error->code == G_USB_DEVICE_ERROR_TIMED_OUT ||
+          error->code == G_USB_DEVICE_ERROR_IO ||
+          error->code == G_USB_DEVICE_ERROR_FAILED ||
+          error->code == G_USB_DEVICE_ERROR_NOT_SUPPORTED ||
+          error->code == G_USB_DEVICE_ERROR_INTERNAL);
+}
+
+/* Returns @msg split into 64-byte writes. Continuation chunks prepend the
+ * command byte | 1 and carry up to 63 more bytes of message data. */
+static guint8 *
+goodix_frame_direct (const guint8 *msg, gsize msg_len, gsize *out_len)
+{
+  gsize first_len = MIN (msg_len, GOODIX_USB_CHUNK_SIZE);
+  gsize total_chunks = 1 + (msg_len - first_len + 62) / 63;
+  gsize padded_len = total_chunks * GOODIX_USB_CHUNK_SIZE;
+  guint8 *chunked = g_malloc0 (padded_len);
+  gsize src_offset = first_len;
+
+  memcpy (chunked, msg, first_len);
+  for (gsize dst_offset = GOODIX_USB_CHUNK_SIZE;
+       dst_offset < padded_len; dst_offset += GOODIX_USB_CHUNK_SIZE)
+    {
+      gsize data_in_chunk = MIN (63, msg_len - src_offset);
+
+      chunked[dst_offset] = msg[0] | 1;
+      memcpy (chunked + dst_offset + 1, msg + src_offset, data_in_chunk);
+      src_offset += data_in_chunk;
+    }
+
+  *out_len = padded_len;
+  return chunked;
+}
+
+/* Native posts one 0x8000-byte read and traverses that capacity in 64-byte
+ * cells, gated by nonzero received length and first byte. Only transferred
+ * bytes are available here; never parse the unfilled allocation suffix. */
+static void
+goodix_receive_direct (FpiDeviceGoodix53x5 *self, GoodixTransport *operation,
+                       const guint8 *data, gsize len)
+{
+  if (len && data[0])
+    for (gsize offset = 0; offset < len; offset += GOODIX_USB_CHUNK_SIZE)
+      goodix_rx_cell (operation, data + offset, MIN (GOODIX_USB_CHUNK_SIZE, len - offset));
+}
+
+static gboolean
+goodix_htsec_repair_arm (guint8 status)
+{
+  return (status & 3) == 3;
+}
+
+static gboolean
+goodix_htsec_wake_arm_up (gboolean waiting_up)
+{
+  return waiting_up;
+}
+
+static gboolean
+goodix_htsec_notice_irq (FpiDeviceGoodix53x5 *self, const guint8 *payload, gsize len)
+{
+  memcpy (self->shared_response_storage, payload,
+          MIN (len, sizeof (self->shared_response_storage)));
+  memcpy (self->notice_irq, self->shared_response_storage, sizeof (self->notice_irq));
+  return TRUE;
+}
+
+/* 53x5 native gives no message a meaning beyond its reply. */
+static GoodixSensorEvent
+goodix_htsec_event (guint8 category, guint8 command, const guint8 *payload, gsize len)
+{
+  (void) category;
+  (void) command;
+  (void) payload;
+  (void) len;
+  return GOODIX_SENSOR_EVENT_NONE;
+}
+
+/* 53x5 native lets selectors alias: any reply in the slot answers. */
+static gboolean
+goodix_htsec_reply_answers (guint8 category, guint8 command, const GoodixCmd *awaited)
+{
+  (void) category;
+  (void) command;
+  (void) awaited;
+  return TRUE;
+}
+
+/* The download reply's payload is scratch, not a status. */
+static gboolean
+goodix_htsec_download_succeeded (const guint8 *payload, gsize len)
+{
+  (void) payload;
+  (void) len;
+  return TRUE;
+}
+
+/* The driver provisions 53x5 sensors, so it may send any command. */
+static gboolean
+goodix_htsec_may_send (const GoodixCmd *cmd)
+{
+  (void) cmd;
+  return TRUE;
+}
+
+/* 53x5 native checks no MCU platform and continues without a version. */
+GError *
+goodix_htsec_check_firmware (const char *firmware)
+{
+  (void) firmware;
+  return NULL;
+}
+
+static gboolean
+goodix_htsec_rearm_after_capture (FpiDeviceGoodix53x5 *self)
+{
+  (void) self;
+  return TRUE;
+}
+
+static GoodixFdtEventType
+goodix_htsec_fdt_event (FpiDeviceGoodix53x5 *self, const guint8 *payload,
+                        gsize len, GError **error)
+{
+  (void) self;
+  if (len != 4 + GOODIX_FDT_BASE_LEN)
+    {
+      g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                           "Unexpected FDT event length");
+      return GOODIX_FDT_EVENT_NONE;
+    }
+  switch (payload[0] | ((guint16) payload[1] << 8))
+    {
+    case 0:
+    case 1:
+    case 4:
+    case 8:
+    case 0x10:
+    case 0x20:
+    case 0x40:
+      return GOODIX_FDT_EVENT_NONE;
+    case GOODIX_FDT_IRQ_DOWN:
+      return GOODIX_FDT_EVENT_DOWN;
+    case GOODIX_FDT_IRQ_UP:
+      return GOODIX_FDT_EVENT_UP;
+    case GOODIX_FDT_IRQ_REVERSE:
+    case GOODIX_FDT_IRQ_REVERSE_ALT:
+      return GOODIX_FDT_EVENT_REVERSE;
+    default:
+      return GOODIX_FDT_EVENT_CONFIG;
+    }
+}
+
+const GoodixFamily goodix_family_htsec = {
+  .link = {
+    .usb_interface = 1,
+    .ep_in = GOODIX_EP_IN,
+    .ep_out = GOODIX_EP_OUT,
+    .frame = goodix_frame_direct,
+    .frame_record = NULL,
+    .receive = goodix_receive_direct,
+    .discard = NULL,
+  },
+  .protocol = {
+    .wake_payload_len = 2,
+    .ec_on_payload = { 0x01, 0x01, 0x00 },
+    .command_budget = goodix_htsec_command_budget,
+    .retry_write = goodix_htsec_retry_write,
+    .repair_arm = goodix_htsec_repair_arm,
+    .wake_arm_up = goodix_htsec_wake_arm_up,
+    .notice_irq = goodix_htsec_notice_irq,
+    .fdt_event = goodix_htsec_fdt_event,
+    .ack_timeout_waits_for_data = FALSE,
+    .event = goodix_htsec_event,
+    .reply_answers = goodix_htsec_reply_answers,
+    .download_succeeded = goodix_htsec_download_succeeded,
+    .may_send = goodix_htsec_may_send,
+  },
+  .channel = {
+    .name = "GTLS",
+    /* deviceInit runs the three-attempt wrapper twice; the event restart once. */
+    .attempts = { .open = 6, .after_failed_read = 3, .reconnect = 3 },
+    .retry_delay_ms = 10,
+    .attempt_new = goodix_gtls_attempt_new,
+    .decrypt_frame = goodix_decrypt_frame_gtls,
+    .image_error = goodix_gtls_image_error,
+    .rearm_after_capture = goodix_htsec_rearm_after_capture,
+    .restart_disarms = FALSE,
+    .config_lost = NULL,
+    .discard = goodix_gtls_discard,
+  },
+  .open_new = goodix_htsec_open_new,
+};
