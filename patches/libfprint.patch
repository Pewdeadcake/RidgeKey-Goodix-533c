diff --git a/libfprint/drivers/goodix53x5/milan/match/lifecycle.c b/libfprint/drivers/goodix53x5/milan/match/lifecycle.c
new file mode 100644
index 0000000..2b34f86
--- /dev/null
+++ b/libfprint/drivers/goodix53x5/milan/match/lifecycle.c
@@ -0,0 +1,372 @@
+/*
+ * Goodix 53x5 driver for libfprint - native Milan serialized match lifecycle
+ * Copyright (C) 2026 goodix-fp-linux-dev contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
