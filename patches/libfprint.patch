+} GoodixMilanMatcherPolicy;
+
+typedef struct
+{
+  int32_t accumulated_high_class;
+  int32_t probe_low_class;
+  int32_t probe_primary_histogram_class;
+} GoodixMilanMatcherLateContext;
+
+enum
+{
