+
+#pragma once
+
+#define GOODIX_MILAN_TEMPLATE_FEATURE_CAPACITY 50
+#define GOODIX_MILAN_PROFILE9_ACTIVE_FEATURE_LIMIT 40
+#define GOODIX_MILAN_TEMPLATE_RELATION_CAPACITY \
