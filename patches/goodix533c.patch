+  if [[ "${EUID:-$(id -u)}" == 0 && -n "${SUDO_USER:-}" && "$SUDO_USER" != root ]]; then
+    milan_require_command getent
+    entry="$(getent passwd "$SUDO_USER")"
+    [[ -n "$entry" ]] || milan_die "cannot resolve home for $SUDO_USER"
+    printf '%s\n' "$(cut -d: -f6 <<<"$entry")"
