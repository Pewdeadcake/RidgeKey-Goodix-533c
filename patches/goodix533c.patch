+
+milan_require_command() {
+  command -v "$1" >/dev/null 2>&1 || milan_die "required command not found: $1"
+}
+
+milan_require_absolute() {
+  case "$2" in
+    /*) ;;
+    *) milan_die "$1 must be an absolute path: $2" ;;
+  esac
