+                   "partition1_count_u32", "probe_record_count_u32", "stage_u32",
+                   "status_u32", "valid_gallery_u32"):
+        require_uint(runtime[field], UINT32_MAX, f"{path.name}.{field}")
+    if runtime["status_u32"] > 4:
